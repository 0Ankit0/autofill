{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["chrome", "vitest/globals"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "."
